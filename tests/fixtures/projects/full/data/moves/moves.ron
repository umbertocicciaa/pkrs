        id: "ember", name: "text:moves.ember", type: "fire", category: Special,
        power: 40, accuracy: 100, pp: 25, priority: 0, target: SingleOpponent,
        effects: [(effect: "damage"), (effect: "apply_status", status: "burn", chance: 10)],
    ),
    Move(
        id: "flame_burst", name: "text:moves.flame_burst", type: "fire", category: Special,
        power: 70, accuracy: 100, pp: 15, priority: 0, target: AllOpponents,
        effects: [(effect: "damage")],
    ),
    Move(
        id: "scratch", name: "text:moves.scratch", type: "normal", category: Physical,
        power: 40, accuracy: 100, pp: 35, priority: 0, flags: ["contact"],
        effects: [(effect: "damage")],
    ),
    (id: "tackle", type: "normal", category: physical, power: 40, accuracy: 100, priority: 0,
     flags: ["contact"], effects: [(effect: "damage")]),
    (id: "water_gun", type: "water", category: special, power: 40, accuracy: 100, pp: 25,
     priority: 0, effects: [(effect: "damage")]),
    (id: "vine_whip", type: "grass", category: physical, power: 45, accuracy: 100, pp: 25,
